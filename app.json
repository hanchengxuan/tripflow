{
  "expo": {
    "name": "TripFlow 旅途流",
    "slug": "tripflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/tripflow-icon.png",
    "scheme": "tripflow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.hanchengxuan.tripflow",
      "buildNumber": "1",
      "supportsTablet": false,
      "icon": "./assets/images/tripflow-icon.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleDevelopmentRegion": "zh_CN"
      }
    },
    "android": {
      "package": "com.hanchengxuan.tripflow",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/tripflow-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "zh-Hans"
            ],
            "android": [
              "zh-Hans"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 TripFlow 从相册选择消费小票。",
          "cameraPermission": "允许 TripFlow 拍摄消费小票。",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/tripflow-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许 TripFlow 录制语音并生成可编辑的记账草稿。"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "zh-Hans": "./locales/zh-Hans.json"
    }
  }
}
